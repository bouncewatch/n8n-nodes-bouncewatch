{
  "name": "n8n-nodes-bouncewatch",
  "version": "0.1.3",
  "description": "Bounce Watch company signals for n8n \u2014 who raised, who is hiring, who expanded, and when it happened",
  "keywords": [
    "n8n-community-node-package",
    "bouncewatch",
    "company-signals",
    "buying-signals",
    "sales-intelligence",
    "funding",
    "prospecting"
  ],
  "license": "MIT",
  "homepage": "https://github.com/bouncewatch/n8n-nodes-bouncewatch#readme",
  "author": {
    "name": "Bounce Watch",
    "email": "sedat@bouncewatch.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bouncewatch/n8n-nodes-bouncewatch.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "build": "npx rimraf dist && tsc && gulp build:icons",
    "dev": "tsc --watch",
    "lint": "n8n-node lint",
    "prepublishOnly": "npm run build",
    "lint:fix": "n8n-node lint --fix"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/BounceWatchApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/BounceWatch/BounceWatch.node.js",
      "dist/nodes/BounceWatch/BounceWatchTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.44.2",
    "@types/node": "^20.19.0",
    "gulp": "^5.0.0",
    "n8n-workflow": "*",
    "rimraf": "^5.0.5",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
