      "channelId": {
        "__rl": true,
        "mode": "list",
        "value": "YOUR_SLACK_CHANNEL_ID",
        "cachedResultName": "your-alerts-channel"
      },
      "otherOptions": {},
      "authentication": "oAuth2"
    }
  },
