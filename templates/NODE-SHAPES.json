  "slack": {
    "type": "n8n-nodes-base.slack",
    "typeVersion": 2.3,
    "parameters": {
      "text": "=🚨 *RentalOS Workflow Error*\n\n*Workflow:* {{ $workflow.name }}\n*Failed Node:* {{ $execution.lastNodeExecuted }}\n*Time:* {{ $now.format('MMM D, YYYY – HH:mm') }}\n*Execution ID:* {{ $execution.id }}\n\nPlease check the n8n execution log and follow up with the applicant manually if needed.",
